API_GATEWAY_URL=http://localhost:8080
# Comma separated list of front-end features to switch on (read per request by /api/features). Empty means all off.
# Known: vouchers, audit, security-alerts, system-health, ledger, reconciliation, time-controls, refunds.
# A flag only shows or hides a screen. The back end stays the guard for who may do what.
FEATURES=
# Address of the Gateway the BROWSER connects to for live auction updates (WebSocket). Empty means live updates are off and the room refreshes on a timer.
REALTIME_URL=
